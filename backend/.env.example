# Conexión a base de datos Turso / LibSQL (Producción Vercel)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Requerido en producción: mínimo recomendado 32 caracteres aleatorios
AUTH_SECRET=

# Requerido solamente al ejecutar db:seed o db:user en producción
INITIAL_USER_PASSWORD=

# Orígenes permitidos, separados por coma. Admite un comodín por origen para previews.
# Ej: https://mi-frontend.vercel.app,https://mi-frontend-*.vercel.app
FRONTEND_URL=

# Puerto local del servidor API Hono
PORT=3001
