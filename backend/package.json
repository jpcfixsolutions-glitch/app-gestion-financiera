{
  "name": "app-gestion-financiera-backend",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "scripts": {
    "dev": "node --watch src/dev.js",
    "start": "node src/dev.js",
    "build": "node --check src/dev.js && node --check api/index.js",
    "test": "node --test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "node src/scripts/seed.js",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "db:user": "node src/scripts/create-user.js",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  }
}
