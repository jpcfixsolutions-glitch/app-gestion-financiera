{
  "name": "app-gestion-financiera-backend",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@10.34.3",
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "start": "tsx src/dev.ts",
    "build": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts src/services/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "db:user": "tsx src/scripts/create-user.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^5.7.0"
  }
}
